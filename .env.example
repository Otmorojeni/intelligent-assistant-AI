# Database Configuration (PostgreSQL in Docker)
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5433
POSTGRES_DB=cdo_assistant
POSTGRES_USER=cdo_admin
POSTGRES_PASSWORD=your_secure_password_here
DATABASE_URL=postgresql+psycopg://cdo_admin:your_secure_password_here@127.0.0.1:5433/cdo_assistant
DATABASE_URL_SYNC=postgresql+psycopg://cdo_admin:your_secure_password_here@127.0.0.1:5433/cdo_assistant

# Local LLM (Ollama)
OLLAMA_BASE_URL=http://localhost:11434/v1
OLLAMA_MODEL=qwen2.5:1.5b
OLLAMA_FALLBACK_MODEL=qwen2.5:3b

# Application
APP_HOST=0.0.0.0
APP_PORT=8000
ENVIRONMENT=development
LOG_LEVEL=INFO

# Security & RBAC
SECRET_KEY=your_random_secret_key_here
ACCESS_TOKEN_EXPIRE_MINUTES=1440
