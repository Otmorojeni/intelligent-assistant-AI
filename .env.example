# Database Configuration (PostgreSQL 16 + pgvector in Docker)
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5433
POSTGRES_DB=cdo_assistant
POSTGRES_USER=cdo_admin
POSTGRES_PASSWORD=cdo_secure_pass_2026
DATABASE_URL=postgresql+psycopg://cdo_admin:cdo_secure_pass_2026@127.0.0.1:5433/cdo_assistant
DATABASE_URL_SYNC=postgresql+psycopg://cdo_admin:cdo_secure_pass_2026@127.0.0.1:5433/cdo_assistant

# Local LLM (Ollama — tuned for MSKs-2 VM: 2 vCPU, 4 GB RAM)
OLLAMA_BASE_URL=http://localhost:11434/v1
OLLAMA_MODEL=qwen2.5:1.5b
OLLAMA_FALLBACK_MODEL=qwen2.5:1.5b
LLM_TEMPERATURE=0.0
LLM_TIMEOUT_SECONDS=45.0
LLM_NUM_CTX=2048
LLM_NUM_PREDICT=450
LLM_NUM_THREAD=2
LLM_KEEP_ALIVE=24h

# Application
APP_HOST=0.0.0.0
APP_PORT=8000
ENVIRONMENT=development
LOG_LEVEL=INFO

# Security & RBAC
SECRET_KEY=your_random_secret_key_here
ACCESS_TOKEN_EXPIRE_MINUTES=1440
ADMIN_DEMO_PASSWORD=cdo-admin-2026
